user  nginx;  # 設定 Nginx 的執行用戶
worker_processes  auto;  # 自動設定工作進程數量

error_log  /var/log/nginx/error.log notice;  # 設定錯誤日誌文件及日誌級別
pid        /var/run/nginx.pid;  # 設定存放 Nginx 進程 ID 的文件

events {
    worker_connections  1024;  # 設定每個工作進程的最大連接數
}

http {
    include       /etc/nginx/mime.types;  # 包含 MIME 類型文件
    default_type  application/octet-stream;  # 設定默認的 MIME 類型

    # 設定 JSON 格式的訪問日誌
    log_format json_combined escape=json
        '{'
        '"time_local":"$time_local",'
        '"remote_addr":"$remote_addr",'
        '"request":"$request",'
        '"status":$status,'
        '"body_bytes_sent":$body_bytes_sent,'
        '"http_referer":"$http_referer",'
        '"http_user_agent":"$http_user_agent",'
        '"request_time":$request_time,'
        '"upstream_response_time":"$upstream_response_time",'
        '"upstream_addr":"$upstream_addr",'
        '"upstream_status":"$upstream_status",'
        '"http_x_forwarded_for":"$http_x_forwarded_for"'
        '}';

    # 設定日誌記錄條件
    map $status $loggable {
        ~^[23]  0;  # 2xx 和 3xx 的請求不記錄
        default 1;  # 4xx 和 5xx 錯誤才記錄
    }

    access_log /var/log/nginx/access.log json_combined if=$loggable;  # 設定訪問日誌文件及日誌格式

    open_log_file_cache max=1000 inactive=60s;  # 設定日誌文件緩存

    sendfile        on;  # 啟用高效文件傳輸模式
    tcp_nopush     off;  # 禁用 TCP_NOPUSH 選項

    gzip  on;  # 啟用 gzip 壓縮
    gzip_types text/x-component text/css application/x-javascript application/javascript text/javascript text/x-js text/richtext text/plain text/xml; # 設定 gzip 壓縮類型
    gzip_comp_level 5; # 設定 gzip 壓縮等級

    # 防止攻擊的防護手段
    limit_req_zone $binary_remote_addr zone=one:10m rate=1r/s;  # 設定請求速率限制區域（依實際流量調整）
    client_max_body_size 1m;  # 設定客戶端請求體的最大大小
    client_body_timeout 10s;  # 設定客戶端請求體讀取的超時時間
    client_header_timeout 10s;  # 設定客戶端請求頭讀取的超時時間
    keepalive_timeout 15s;  # 設定保持連接的超時時間
    send_timeout 10s;  # 設定響應發送的超時時間

    server {
        listen       80;  # 純 HTTP，未啟用 SSL（憑證可交由 Cloudflare Tunnel 等反向代理處理）

        server_name   api.yourdomain.com;  # 設定服務器名稱，請改成實際的 API 網域

        location / {
            proxy_pass http://backend:3000/;  # 設定代理後端服務
            limit_req zone=one burst=5;  # 設定請求速率限制

            proxy_set_header Host $host;  # 設定代理請求的 Host 頭
            proxy_set_header X-Real-IP $remote_addr;  # 設定代理請求的 X-Real-IP 頭
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  # 設定代理請求的 X-Forwarded-For 頭
            proxy_set_header X-Forwarded-Proto $scheme;  # 設定代理請求的 X-Forwarded-Proto 頭

            # 設定代理請求的 CORS 標頭
            if ($request_method = 'OPTIONS') {
                add_header Access-Control-Allow-Origin *;
                add_header Access-Control-Max-Age 1728000;
                add_header Access-Control-Allow-Methods GET,POST,OPTIONS;
                add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range';
                add_header Content-Type 'text/plain; charset=utf-8';
                add_header Content-Length 0;
                return 204;
            }

            # 響應 CORS 請求（請改成實際允許的前端網域）
            if ($http_origin ~* (^https://frontend\.yourdomain\.com$)) {
                add_header  Access-Control-Allow-Origin $http_origin;
                add_header  Access-Control-Allow-Credentials true;
                add_header  Access-Control-Allow-Methods GET,POST,OPTIONS;
                add_header  Access-Control-Expose-Headers Content-Length,Content-Range;
            }
        }

    }
}
